@model IEnumerable<QMS.Models.DTOs.DepartmentDto>

@{
    ViewBag.Title = "Departments";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        .page-card {
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.08);
            padding: 25px;
        }

        .page-toolbar {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 18px;
        }

        .btn {
            display: inline-block;
            padding: 9px 16px;
            border-radius: 5px;
            font-size: 14px;
            font-weight: bold;
            text-decoration: none;
            border: none;
            cursor: pointer;
        }

        .btn-primary {
            background: #0f172a;
            color: white;
        }

            .btn-primary:hover {
                background: #1e293b;
            }

        .btn-secondary {
            background: #e2e8f0;
            color: #333;
        }

            .btn-secondary:hover {
                background: #cbd5e1;
            }

        .btn-danger {
            background: #dc2626;
            color: white;
        }

            .btn-danger:hover {
                background: #b91c1c;
            }

        .btn-sm {
            padding: 6px 12px;
            font-size: 13px;
        }

        .alert-success {
            background: #dcfce7;
            color: #166534;
            padding: 12px 16px;
            border-radius: 6px;
            margin-bottom: 18px;
        }

        table.data-table {
            width: 100%;
            border-collapse: collapse;
        }

            table.data-table th {
                text-align: left;
                background: #f1f5f9;
                color: #0f172a;
                padding: 12px 14px;
                border-bottom: 2px solid #e2e8f0;
                font-size: 13px;
                text-transform: uppercase;
                letter-spacing: .5px;
            }

            table.data-table td {
                padding: 12px 14px;
                border-bottom: 1px solid #eef1f4;
                font-size: 14px;
            }

            table.data-table tr:hover td {
                background: #f8fafc;
            }

        .badge {
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: bold;
        }

        .badge-active {
            background: #dcfce7;
            color: #166534;
        }

        .badge-inactive {
            background: #fee2e2;
            color: #991b1b;
        }

        .row-actions a {
            margin-right: 6px;
        }
    </style>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success">@TempData["SuccessMessage"]</div>
}

<div class="page-card">
    <div class="page-toolbar">
        <a href="@Url.Action("Create")" class="btn btn-primary">+ Create New Department</a>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(m => m.Name)</th>
                <th>@Html.DisplayNameFor(m => m.Code)</th>
                <th>@Html.DisplayNameFor(m => m.IsActive)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Code</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge badge-active">Active</span>
                        }
                        else
                        {
                            <span class="badge badge-inactive">Inactive</span>
                        }
                    </td>
                    <td class="row-actions">
                        <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-secondary btn-sm">Details</a>
                        <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-secondary btn-sm">Edit</a>
                        <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
