@model QMS.Models.DTOs.ExcelImportResultDto
@{
    ViewBag.Title = "Import Results";
    ViewBag.ActiveMenu = "EmployeeMasterImport";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <a href="@Url.Action("ImportExcel", "EmployeeMaster")" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Back to Import
    </a>
    <div class="result-banner">
        <div class="result-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        </div>
        <div>
            <h2>Import Completed</h2>
            <p>Your Excel file has been processed. See the summary below.</p>
        </div>
    </div>
</div>

<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon stat-icon-neutral">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
        </div>
        <div class="stat-label">Total Rows</div>
        <div class="stat-number">@Model.TotalRows</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon stat-icon-green">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        </div>
        <div class="stat-label">Inserted</div>
        <div class="stat-number stat-green">@Model.Inserted</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon stat-icon-blue">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
        </div>
        <div class="stat-label">Updated</div>
        <div class="stat-number stat-blue">@Model.Updated</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon stat-icon-red">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        </div>
        <div class="stat-label">Skipped / Errors</div>
        <div class="stat-number stat-red">@Model.Skipped</div>
    </div>
</div>

@if (Model.Errors.Any())
{
    <div class="error-card">
        <h3>Row Errors</h3>
        <ul class="error-list">
            @foreach (var err in Model.Errors)
            {
                <li>@err</li>
            }
        </ul>
    </div>
}

<div class="result-actions">
    <a href="@Url.Action("Index")" class="btn-primary">Back to Employee List</a>
    <a href="@Url.Action("ImportExcel")" class="btn-secondary">Import Another File</a>
</div>

@section Styles {
    <style>
        .page-header {
            margin-bottom: 24px;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            color: #64748b;
            text-decoration: none;
            margin-bottom: 14px;
        }

            .back-link:hover {
                color: #0f172a;
            }

        .result-banner {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .result-icon {
            flex-shrink: 0;
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: #dcfce7;
            color: #15803d;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .result-banner h2 {
            margin-bottom: 2px;
        }

        .result-banner p {
            color: #777;
            font-size: 14px;
        }

        .stat-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: white;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            padding: 22px;
        }

        .stat-icon {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 14px;
        }

        .stat-icon-neutral {
            background: #f1f5f9;
            color: #64748b;
        }

        .stat-icon-green {
            background: #dcfce7;
            color: #15803d;
        }

        .stat-icon-blue {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .stat-icon-red {
            background: #fee2e2;
            color: #991b1b;
        }

        .stat-label {
            font-size: 13px;
            color: #777;
            margin-bottom: 6px;
        }

        .stat-number {
            font-size: 28px;
            font-weight: bold;
            color: #0f172a;
        }

        .stat-green {
            color: #15803d;
        }

        .stat-blue {
            color: #1d4ed8;
        }

        .stat-red {
            color: #991b1b;
        }

        .error-card {
            background: white;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            padding: 24px;
            margin-bottom: 24px;
        }

            .error-card h3 {
                margin-bottom: 14px;
                font-size: 15px;
            }

        .error-list {
            background: #fee2e2;
            padding: 14px 14px 14px 30px;
            border-radius: 8px;
            color: #991b1b;
            font-size: 13px;
        }

            .error-list li {
                margin-bottom: 6px;
            }

                .error-list li:last-child {
                    margin-bottom: 0;
                }

        .result-actions {
            display: flex;
            gap: 12px;
        }

        .btn-primary {
            padding: 12px 22px;
            border: none;
            border-radius: 6px;
            background: #0f172a;
            color: white;
            font-weight: bold;
            font-size: 14px;
            text-decoration: none;
        }

            .btn-primary:hover {
                background: #1e293b;
            }

        .btn-secondary {
            padding: 12px 22px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            background: white;
            color: #0f172a;
            font-weight: bold;
            font-size: 14px;
            text-decoration: none;
        }

            .btn-secondary:hover {
                background: #f4f6fb;
                border-color: #0f172a;
            }

        @@media (max-width: 900px) {
            .stat-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 500px) {
            .stat-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}
