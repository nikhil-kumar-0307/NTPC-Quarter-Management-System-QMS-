@model IEnumerable<QMS.Data.Models.EmployeeMaster>

@{
    ViewBag.Title = "Employee Master";
    ViewBag.ActiveMenu = "EmployeeMaster";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="welcome list-header">
    <div>
        <h2>Employee Master</h2>
        <p>Employee records and their quarter allotment status.</p>
    </div>
    <a href="@Url.Action("Create", "EmployeeMaster")" class="btn-primary">+ Add Employee</a>
</div>

<div class="table-card">
    <table class="emp-table">
        <thead>
            <tr>
                <th></th>
                <th>Name</th>
                <th>Employee No</th>
                <th>Department</th>
                <th>Designation</th>
                <th>Mobile No</th>
                <th>Quarter No</th>
                <th>Quarter Type</th>
                <th>Status</th>
                <th>DOB</th>
                <th>Retirement Date</th>
                <th>Blood Group</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="11" class="empty-row">No employees added yet.</td>
                </tr>
            }
            else
            {
                foreach (var emp in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(emp.PhotoPath))
                            {
                                <img src="@Url.Content(emp.PhotoPath)" class="avatar" alt="@emp.EmployeeName" />
                            }
                            else
                            {
                                <div class="avatar avatar-placeholder">@emp.EmployeeName.Substring(0, 1)</div>
                            }
                        </td>
                        <td>@emp.EmployeeName</td>
                        <td class="id-field">@emp.EmployeeNo</td>
                        <td>@emp.Department</td>
                        <td>@emp.Designation</td>
                        <td>@emp.MobileNo</td>
                        <td class="id-field">@emp.QuarterNo</td>
                        <td>@emp.QuarterType</td>
                        <td><span class="badge badge-@emp.Status.ToLower()">@emp.Status</span></td>
                        <td>@emp.DateOfBirth.ToString("dd-MMM-yyyy")</td>
                        <td>@emp.DateOfRetirement.ToString("dd-MMM-yyyy")</td>
                        <td>@emp.BloodGroup</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@section Styles {
    <style>
        .list-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

            .list-header h2 {
                margin-bottom: 6px;
            }

            .list-header p {
                color: #777;
            }

        .btn-primary {
            padding: 10px 20px;
            border: none;
            border-radius: 6px;
            background: #0f172a;
            color: white;
            font-weight: bold;
            font-size: 14px;
            text-decoration: none;
        }

            .btn-primary:hover {
                background: #1e293b;
            }

        .table-card {
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            overflow: auto;
        }

        .emp-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 1100px;
        }

            .emp-table th {
                text-align: left;
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                color: #777;
                background: #f4f6fb;
                padding: 14px 18px;
                white-space: nowrap;
            }

            .emp-table td {
                padding: 14px 18px;
                border-top: 1px solid #eee;
                font-size: 14px;
                white-space: nowrap;
            }

        .id-field {
            font-family: 'IBM Plex Mono', monospace;
        }

        .empty-row {
            text-align: center;
            color: #999;
            padding: 30px !important;
        }

        .avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
        }

        .avatar-placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            background: #0f172a;
            color: white;
            font-weight: bold;
            font-size: 13px;
        }

        .badge {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }

        .badge-active {
            background: #dcfce7;
            color: #15803d;
        }

        .badge-empty {
            background: #f1f5f9;
            color: #64748b;
        }

        .badge-retained {
            background: #fef3c7;
            color: #b45309;
        }

        .badge-agency {
            background: #dbeafe;
            color: #1d4ed8;
        }
    </style>
}