@model QMS.Models.DTOs.EmployeeMasterDto

@{
    ViewBag.Title = "Edit Employee";
    ViewBag.ActiveMenu = "EmployeeMaster";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <a href="@Url.Action("Index", "EmployeeMaster")" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Back to Employee List
    </a>
    <h2>Edit Employee</h2>
    <p>Update employee, contact, and quarter allotment details.</p>
</div>

@using (Html.BeginForm("Edit", "EmployeeMaster", FormMethod.Post, new { enctype = "multipart/form-data", id = "employeeForm" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.ExistingPhotoPath)
    @Html.ValidationSummary(true, "", new { @class = "validation-summary" })

    <div class="form-layout">

        <div class="form-main">

            <div class="form-section">
                <div class="section-title">
                    <span class="section-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    </span>
                    Personal Details
                </div>
                <div class="form-grid">
                    <div class="form-group">
                        @Html.LabelFor(m => m.EmployeeName)
                        @Html.TextBoxFor(m => m.EmployeeName, new { @class = "form-control", placeholder = "Full name" })
                        @Html.ValidationMessageFor(m => m.EmployeeName, "", new { @class = "validation-error" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.EmployeeNo)
                        @Html.TextBoxFor(m => m.EmployeeNo, new { @class = "form-control id-field", placeholder = "e.g. EMP1024" })
                        @Html.ValidationMessageFor(m => m.EmployeeNo, "", new { @class = "validation-error" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Department)
                        @Html.TextBoxFor(m => m.Department, new { @class = "form-control", placeholder = "e.g. Operations" })
                        @Html.ValidationMessageFor(m => m.Department, "", new { @class = "validation-error" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Designation)
                        @Html.TextBoxFor(m => m.Designation, new { @class = "form-control", placeholder = "e.g. Junior Engineer" })
                        @Html.ValidationMessageFor(m => m.Designation, "", new { @class = "validation-error" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.DateOfBirth)
                        @{
                            var dobValue = Model.DateOfBirth == default(DateTime) ? "" : Model.DateOfBirth.ToString("yyyy-MM-dd");
                        }
                        <input type="date" name="DateOfBirth" id="DateOfBirth" class="form-control" value="@dobValue" />
                        @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "validation-error" })
                        <small class="hint">Retirement date is auto-calculated (DOB + 60 years).</small>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.BloodGroup)
                        @Html.DropDownListFor(m => m.BloodGroup, (SelectList)ViewBag.BloodGroups, "Select blood group", new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.BloodGroup, "", new { @class = "validation-error" })
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="section-title">
                    <span class="section-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                    </span>
                    Contact Details
                </div>
                <div class="form-grid">
                    <div class="form-group">
                        @Html.LabelFor(m => m.EmailId)
                        @Html.TextBoxFor(m => m.EmailId, new { @class = "form-control", placeholder = "name@ntpc.co.in" })
                        @Html.ValidationMessageFor(m => m.EmailId, "", new { @class = "validation-error" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.MobileNo)
                        @Html.TextBoxFor(m => m.MobileNo, new { @class = "form-control", placeholder = "Mobile number" })
                        @Html.ValidationMessageFor(m => m.MobileNo, "", new { @class = "validation-error" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.IntercomResidence)
                        @Html.TextBoxFor(m => m.IntercomResidence, new { @class = "form-control", placeholder = "Residence intercom no." })
                        @Html.ValidationMessageFor(m => m.IntercomResidence, "", new { @class = "validation-error" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.IntercomOffice)
                        @Html.TextBoxFor(m => m.IntercomOffice, new { @class = "form-control", placeholder = "Office intercom no." })
                        @Html.ValidationMessageFor(m => m.IntercomOffice, "", new { @class = "validation-error" })
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="section-title">
                    <span class="section-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                    </span>
                    Quarter Allotment
                </div>
                <div class="form-grid">
                    <div class="form-group">
                        @Html.LabelFor(m => m.QuarterNo)
                        @Html.TextBoxFor(m => m.QuarterNo, new { @class = "form-control id-field", placeholder = "e.g. Q-204" })
                        @Html.ValidationMessageFor(m => m.QuarterNo, "", new { @class = "validation-error" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.QuarterType)
                        @Html.DropDownListFor(m => m.QuarterType, (SelectList)ViewBag.QuarterTypes, "Select type", new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.QuarterType, "", new { @class = "validation-error" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Status)
                        @Html.DropDownListFor(m => m.Status, (SelectList)ViewBag.StatusOptions, "Select status", new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Status, "", new { @class = "validation-error" })
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <a href="@Url.Action("Index", "EmployeeMaster")" class="btn-secondary">Cancel</a>
                <button type="submit" class="btn-primary">Save Changes</button>
            </div>

        </div>

        <div class="form-side">
            <div class="photo-card">
                <div class="section-title">
                    <span class="section-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
                    </span>
                    Photo
                </div>

                <label for="photoInput" class="photo-upload" id="photoUpload">
                    <div class="photo-preview" id="photoPreview">
                        @if (!string.IsNullOrEmpty(Model.ExistingPhotoPath))
                        {
                            <img src="@Url.Content(Model.ExistingPhotoPath)" alt="Current photo" />
                        }
                        else
                        {
                            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        }
                    </div>
                    <span class="photo-upload-text" id="photoUploadText">
                        @(string.IsNullOrEmpty(Model.ExistingPhotoPath) ? "Click to upload photo" : "Click to change photo")
                    </span>
                    <span class="photo-upload-hint">JPG or PNG</span>
                    @Html.TextBoxFor(m => m.Photo, new { type = "file", id = "photoInput", @class = "photo-input", accept = "image/*" })
                </label>
                @Html.ValidationMessageFor(m => m.Photo, "", new { @class = "validation-error" })
            </div>
        </div>

    </div>
}

@section Scripts {
    <script>
        (function () {
            var photoInput = document.getElementById('photoInput');
            var photoPreview = document.getElementById('photoPreview');
            var photoUploadText = document.getElementById('photoUploadText');

            photoInput.addEventListener('change', function () {
                if (photoInput.files && photoInput.files[0]) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        photoPreview.innerHTML = '<img src="' + e.target.result + '" alt="Preview" />';
                    };
                    reader.readAsDataURL(photoInput.files[0]);
                    photoUploadText.textContent = photoInput.files[0].name;
                }
            });
        })();
    </script>
}

@section Styles {
    <style>
        .page-header {
            margin-bottom: 24px;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            color: #64748b;
            text-decoration: none;
            margin-bottom: 14px;
        }

            .back-link:hover {
                color: #0f172a;
            }

        .page-header h2 {
            margin-bottom: 6px;
        }

        .page-header p {
            color: #777;
        }

        .validation-summary {
            color: #842029;
            background: #f8d7da;
            border: 1px solid #f5c6cb;
            padding: 10px 12px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 13px;
        }

        .form-layout {
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 24px;
            align-items: start;
        }

        .form-main {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .form-section {
            background: white;
            padding: 26px 28px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 15px;
            font-weight: bold;
            color: #0f172a;
            margin-bottom: 20px;
            padding-bottom: 14px;
            border-bottom: 1px solid #eef1f6;
        }

        .section-icon {
            width: 30px;
            height: 30px;
            border-radius: 7px;
            background: #f1f5f9;
            color: #0f172a;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-weight: bold;
            font-size: 13px;
            color: #444;
        }

        .form-control {
            width: 100%;
            padding: 11px 12px;
            border: 1px solid #d8dee8;
            background: #f4f6fb;
            border-radius: 6px;
            font-size: 14px;
            font-family: inherit;
        }

            .form-control:focus {
                outline: none;
                border-color: #0f172a;
                background: white;
            }

        .id-field {
            font-family: 'IBM Plex Mono', monospace;
            letter-spacing: 0.5px;
        }

        .hint {
            display: block;
            margin-top: 4px;
            font-size: 11px;
            color: #999;
        }

        .validation-error {
            color: #dc3545;
            font-size: 12px;
            margin-top: 4px;
            display: block;
        }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
        }

        .btn-primary {
            padding: 12px 26px;
            border: none;
            border-radius: 6px;
            background: #0f172a;
            color: white;
            font-weight: bold;
            font-size: 14px;
            cursor: pointer;
        }

            .btn-primary:hover {
                background: #1e293b;
            }

        .btn-secondary {
            padding: 12px 26px;
            border-radius: 6px;
            border: 1px solid #d8dee8;
            background: white;
            color: #444;
            text-decoration: none;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
        }

            .btn-secondary:hover {
                background: #f4f6fb;
            }

        .form-side {
            position: sticky;
            top: 20px;
        }

        .photo-card {
            background: white;
            padding: 24px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .photo-upload {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            border: 2px dashed #cbd5e1;
            border-radius: 10px;
            padding: 28px 16px;
            cursor: pointer;
            text-align: center;
            transition: border-color .15s, background .15s;
        }

            .photo-upload:hover {
                border-color: #0f172a;
                background: #f8fafc;
            }

            .photo-upload input[type="file"] {
                position: absolute;
                inset: 0;
                opacity: 0;
                cursor: pointer;
            }

        .photo-preview {
            width: 84px;
            height: 84px;
            border-radius: 50%;
            background: #f1f5f9;
            color: #94a3b8;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

            .photo-preview img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .photo-upload-text {
            font-size: 13px;
            font-weight: 600;
            color: #0f172a;
            word-break: break-word;
        }

        .photo-upload-hint {
            font-size: 11px;
            color: #999;
        }

        @@media (max-width: 900px) {
            .form-layout {
                grid-template-columns: 1fr;
            }

            .form-side {
                position: static;
            }
        }

        @@media (max-width: 600px) {
            .form-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}
