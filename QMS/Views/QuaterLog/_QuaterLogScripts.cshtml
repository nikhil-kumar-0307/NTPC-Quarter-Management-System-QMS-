<script>
    (function () {

        // ================= Quater No (filtered by type) =================
        var quarterMap = @Html.Raw((string)ViewBag.QuaterMapJson ?? "{}");

        var typeSelect = document.getElementById('QuaterType');
        var noSelect = document.getElementById('QuaterNo');
        var noHint = document.getElementById('quaterNoHint');

        function loadNumbers(selected) {
            var key = (typeSelect.value || '').trim().toUpperCase();
            var list = quarterMap[key] || [];

            noSelect.innerHTML = '';
            var first = document.createElement('option');
            first.value = '';
            first.textContent = 'Select number';
            noSelect.appendChild(first);

            var found = false;
            list.forEach(function (n) {
                var opt = document.createElement('option');
                opt.value = n;
                opt.textContent = n;
                if (selected && n === selected) { opt.selected = true; found = true; }
                noSelect.appendChild(opt);
            });

            // Keep the saved value visible even if that quarter is now inactive
            if (selected && !found) {
                var extra = document.createElement('option');
                extra.value = selected;
                extra.textContent = selected;
                extra.selected = true;
                noSelect.appendChild(extra);
            }

            if (key && list.length === 0) {
                noHint.textContent = 'No active quarters found for type ' + key + '. Add them on the Quarters page first.';
                noHint.style.display = 'block';
            } else {
                noHint.style.display = 'none';
            }
        }

        typeSelect.addEventListener('change', function () { loadNumbers(''); });
        loadNumbers(noSelect.value);   // initial load (Edit / validation error)


        // ================= Searchable dropdown =================
        function makeSearchable(select, placeholder) {
            var wrap = document.createElement('div');
            wrap.className = 'ss-wrap';

            var input = document.createElement('input');
            input.type = 'text';
            input.className = 'form-control ss-input';
            input.placeholder = placeholder;
            input.autocomplete = 'off';

            var list = document.createElement('div');
            list.className = 'ss-list';

            select.parentNode.insertBefore(wrap, select);
            wrap.appendChild(input);
            wrap.appendChild(list);
            wrap.appendChild(select);
            select.style.display = 'none';

            var MAX = 100;
            var options = [];
            for (var i = 0; i < select.options.length; i++) {
                if (select.options[i].value !== '') {
                    options.push({ value: select.options[i].value, text: select.options[i].text });
                }
            }

            var shown = [];
            var activeIndex = -1;

            function selectedText() {
                var o = select.options[select.selectedIndex];
                return (o && o.value !== '') ? o.text : '';
            }

            function setActive(idx) {
                var items = list.getElementsByClassName('ss-item');
                if (!items.length) { activeIndex = -1; return; }
                if (idx < 0) idx = items.length - 1;
                if (idx >= items.length) idx = 0;
                for (var k = 0; k < items.length; k++) items[k].classList.remove('active');
                items[idx].classList.add('active');
                items[idx].scrollIntoView({ block: 'nearest' });
                activeIndex = idx;
            }

            function choose(o) {
                select.value = o.value;
                select.dispatchEvent(new Event('change', { bubbles: true }));
                input.value = o.text;
                close();
            }

            function render(query) {
                var q = query.trim().toLowerCase();
                var matches = options.filter(function (o) {
                    return !q || o.text.toLowerCase().indexOf(q) !== -1;
                });
                shown = matches.slice(0, MAX);
                list.innerHTML = '';

                if (!shown.length) {
                    list.innerHTML = '<div class="ss-empty">No employee found</div>';
                    activeIndex = -1;
                    return;
                }

                shown.forEach(function (o) {
                    var d = document.createElement('div');
                    d.className = 'ss-item' + (o.value === select.value ? ' selected' : '');
                    d.textContent = o.text;
                    d.addEventListener('mousedown', function (e) {
                        e.preventDefault();
                        choose(o);
                    });
                    list.appendChild(d);
                });

                if (matches.length > MAX) {
                    var more = document.createElement('div');
                    more.className = 'ss-more';
                    more.textContent = (matches.length - MAX) + ' more... keep typing to narrow the list';
                    list.appendChild(more);
                }

                setActive(0);
            }

            function open() { list.classList.add('open'); }
            function close() { list.classList.remove('open'); }

            input.addEventListener('focus', function () {
                input.select();
                render('');
                open();
            });

            input.addEventListener('input', function () {
                render(input.value);
                open();
            });

            input.addEventListener('keydown', function (e) {
                if (e.key === 'ArrowDown') { e.preventDefault(); open(); setActive(activeIndex + 1); }
                else if (e.key === 'ArrowUp') { e.preventDefault(); open(); setActive(activeIndex - 1); }
                else if (e.key === 'Enter') {
                    e.preventDefault();   // do not submit the form
                    if (activeIndex >= 0 && shown[activeIndex]) choose(shown[activeIndex]);
                }
                else if (e.key === 'Escape') { close(); input.blur(); }
            });

            input.addEventListener('blur', function () {
                close();
                input.value = selectedText();   // restore the chosen employee
            });

            input.value = selectedText();
        }

        makeSearchable(document.getElementById('AssignedTo'), 'Search by name or employee no...');

    })();
</script>