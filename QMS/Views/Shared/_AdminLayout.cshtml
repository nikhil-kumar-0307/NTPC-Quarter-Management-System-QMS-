<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - QMS Admin</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f6f9;
            color: #333;
        }

        .dashboard {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            width: 240px;
            background: #0f172a;
            color: white;
            padding: 20px;
        }

            .sidebar h2 {
                text-align: center;
                margin-bottom: 30px;
                letter-spacing: 1px;
            }

            .sidebar ul {
                list-style: none;
            }

            .sidebar li {
                margin-bottom: 10px;
            }

            .sidebar a {
                display: block;
                padding: 12px 15px;
                color: #cbd5e1;
                text-decoration: none;
                border-radius: 5px;
                transition: background .15s, color .15s;
            }

                .sidebar a:hover,
                .sidebar a.active {
                    background: #1e293b;
                    color: white;
                }

        /* Main content */
        .main-content {
            flex: 1;
        }

        .topbar {
            height: 70px;
            background: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 30px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.08);
        }

            .topbar h1 {
                font-size: 22px;
            }

        .admin-info {
            font-size: 14px;
            color: #555;
        }

            .admin-info a {
                margin-left: 15px;
                color: #0f172a;
                text-decoration: none;
                font-weight: bold;
            }

        .content {
            padding: 30px;
        }

        @@media (max-width: 900px) {
            .sidebar {
                width: 180px;
            }
        }

        @@media (max-width: 600px) {
            .dashboard {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
            }

            .content {
                padding: 15px;
            }
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>

    <div class="dashboard">

        <aside class="sidebar">
            <h2>QMS</h2>
            <ul>
                <li><a href="@Url.Action("AdminDashboard", "Dashboard")" class="@(ViewBag.ActiveMenu == "Dashboard" ? "active" : "")">Dashboard</a></li>
                <li><a href="@Url.Action("Index", "EmployeeMaster")" class="@(ViewBag.ActiveMenu == "EmployeeMaster" ? "active" : "")">Employee Master</a></li>
                <li><a href="@Url.Action("Index", "Agency")" class="@(ViewBag.ActiveMenu == "Agencies" ? "active" : "")">Agencies</a></li>
                <li><a href="@Url.Action("Login", "Account")">Logout</a></li>
            </ul>
        </aside>

        <main class="main-content">

            <header class="topbar">
                <h1>@ViewBag.Title</h1>
                <div class="admin-info">
                    Welcome, @(Session["EmployeeNumber"] ?? "Admin")
                    <a href="@Url.Action("Login", "Account")">Logout</a>
                </div>
            </header>

            <section class="content">
                @RenderBody()
            </section>

        </main>

    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>