@model IEnumerable<QMS.Models.DTOs.LevelDto>

@{
    ViewBag.Title = "Levels";
    ViewBag.ActiveMenu = "Level";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .btn {
            display: inline-block;
            padding: 9px 16px;
            border-radius: 5px;
            font-size: 14px;
            font-weight: bold;
            text-decoration: none;
            border: none;
            cursor: pointer;
        }

        .btn-primary {
            background: #0f172a;
            color: white;
        }

            .btn-primary:hover {
                background: #1e293b;
            }

        .success-msg {
            background: #d1fae5;
            color: #065f46;
            padding: 10px 14px;
            border-radius: 6px;
            margin-bottom: 18px;
            font-size: 13px;
        }

        .table-card {
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.08);
            overflow: hidden;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 12px 16px;
            text-align: left;
            font-size: 14px;
        }

        th {
            background: #f4f6fb;
            color: #0f172a;
            font-weight: bold;
            border-bottom: 1px solid #e2e8f0;
        }

        tbody tr {
            border-bottom: 1px solid #eef1f6;
        }

            tbody tr:last-child {
                border-bottom: none;
            }

        .badge {
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: bold;
        }

        .badge-active {
            background: #d1fae5;
            color: #065f46;
        }

        .badge-inactive {
            background: #fee2e2;
            color: #991b1b;
        }

        .actions a {
            margin-right: 12px;
            font-size: 13px;
            text-decoration: none;
            color: #0f172a;
            font-weight: bold;
        }

        .empty-row td {
            text-align: center;
            color: #999;
            padding: 30px;
        }
    </style>
}

<div class="page-header">
    <h2>Levels</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary">+ Add Level</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="success-msg">@TempData["SuccessMessage"]</div>
}

<div class="table-card">
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var level in Model)
                {
                    <tr>
                        <td>@level.Name</td>
                        <td>
                            @if (level.IsActive)
                            {
                                <span class="badge badge-active">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-inactive">Inactive</span>
                            }
                        </td>
                        <td class="actions">
                            <a href="@Url.Action("Edit", new { id = level.Id })">Edit</a>
                            <a href="@Url.Action("Details", new { id = level.Id })">Details</a>
                            <a href="@Url.Action("Delete", new { id = level.Id })">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr class="empty-row">
                    <td colspan="3">No levels found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>