@model QMS.Models.DTOs.LevelDto

@{
    ViewBag.Title = "Level Details";
    ViewBag.ActiveMenu = "Level";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        .page-card {
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.08);
            padding: 25px;
            max-width: 500px;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 14px 0;
            border-bottom: 1px solid #eef1f6;
        }

            .detail-row:last-of-type {
                border-bottom: none;
            }

            .detail-row .label {
                font-size: 13px;
                font-weight: bold;
                color: #64748b;
            }

            .detail-row .value {
                font-size: 14px;
                color: #0f172a;
            }

        .badge {
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: bold;
        }

        .badge-active {
            background: #d1fae5;
            color: #065f46;
        }

        .badge-inactive {
            background: #fee2e2;
            color: #991b1b;
        }

        .form-actions {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .btn {
            display: inline-block;
            padding: 9px 16px;
            border-radius: 5px;
            font-size: 14px;
            font-weight: bold;
            text-decoration: none;
            border: none;
            cursor: pointer;
        }

        .btn-primary {
            background: #0f172a;
            color: white;
        }

            .btn-primary:hover {
                background: #1e293b;
            }

        .btn-secondary {
            background: #e2e8f0;
            color: #333;
        }

            .btn-secondary:hover {
                background: #cbd5e1;
            }
    </style>
}

<div class="page-card">
    <div class="detail-row">
        <span class="label">Name</span>
        <span class="value">@Model.Name</span>
    </div>
    <div class="detail-row">
        <span class="label">Status</span>
        <span class="value">
            @if (Model.IsActive)
            {
                <span class="badge badge-active">Active</span>
            }
            else
            {
                <span class="badge badge-inactive">Inactive</span>
            }
        </span>
    </div>

    <div class="form-actions">
        <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-primary">Edit</a>
        <a href="@Url.Action("Index")" class="btn btn-secondary">Back to List</a>
    </div>
</div>