@model QMS.Models.DTOs.QuaterDto

@{
    ViewBag.Title = "Edit Quarter";
    ViewBag.ActiveMenu = "Quater";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <a href="@Url.Action("Index", "Quater")" class="back-link">&larr; Back to Quarter List</a>
    <h2>Edit Quarter</h2>
    <p>Update the quarter details below.</p>
</div>

@using (Html.BeginForm("Edit", "Quater", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.ValidationSummary(true, "", new { @class = "validation-summary" })

    <div class="form-section">
        @Html.Partial("_QuaterForm", Model)

        <div class="form-actions">
            <a href="@Url.Action("Index", "Quater")" class="btn-secondary">Cancel</a>
            <button type="submit" class="btn-primary">Save Changes</button>
        </div>
    </div>
}

@section Styles {
    <link href="~/Content/quater.css" rel="stylesheet" />
}