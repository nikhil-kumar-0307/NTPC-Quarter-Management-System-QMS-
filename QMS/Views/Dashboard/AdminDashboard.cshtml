@model QMS.Models.DTOs.DashboardViewModel
@{
    ViewBag.Title = "Admin Dashboard";
    ViewBag.ActiveMenu = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    int totalQ = Model.TotalQuarters;
    Func<int, int> pct = c => totalQ == 0 ? 0 : (int)Math.Round(c * 100.0 / totalQ);
    int maxDept = Model.DepartmentStats.Any() ? Model.DepartmentStats.Max(d => d.Count) : 1;
}

<div class="db-head">
    <div>
        <h2>Dashboard Overview</h2>
        <p>Employees, quarters and allotments at a glance.</p>
    </div>
    <div class="db-date">@DateTime.Today.ToString("dddd, dd MMMM yyyy")</div>
</div>

<!-- KPI cards -->
<div class="db-kpis">
    <div class="db-kpi">
        <div class="db-kpi-icon c-blue">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        </div>
        <div>
            <div class="db-kpi-label">Total Employees</div>
            <div class="db-kpi-value">@Model.TotalEmployees</div>
            <div class="db-kpi-sub">across @Model.TotalDepartments departments</div>
        </div>
    </div>

    <div class="db-kpi">
        <div class="db-kpi-icon c-slate">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        </div>
        <div>
            <div class="db-kpi-label">Total Quarters</div>
            <div class="db-kpi-value">@Model.TotalQuarters</div>
            <div class="db-kpi-sub">registered in the system</div>
        </div>
    </div>

    <div class="db-kpi">
        <div class="db-kpi-icon c-green">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        </div>
        <div>
            <div class="db-kpi-label">Occupied Quarters</div>
            <div class="db-kpi-value">@Model.OccupiedQuarters</div>
            <div class="db-kpi-sub">@pct(Model.OccupiedQuarters)% of all quarters</div>
        </div>
    </div>

    <div class="db-kpi">
        <div class="db-kpi-icon c-amber">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 9.9-1"></path></svg>
        </div>
        <div>
            <div class="db-kpi-label">Vacant Quarters</div>
            <div class="db-kpi-value">@Model.VacantQuarters</div>
            <div class="db-kpi-sub">available for allotment</div>
        </div>
    </div>
</div>

<!-- Main grid -->
<div class="db-grid">

    <div class="db-col">

        <div class="db-panel">
            <div class="db-panel-head">
                <h3>Quarter Status</h3>
                <a href="@Url.Action("Index", "Quater")" class="db-link">View all</a>
            </div>
            @if (totalQ == 0)
            {
                <div class="db-empty">No quarters added yet.</div>
            }
            else
            {
                <div class="db-statusbar">
                    @foreach (var s in Model.QuarterStatusCounts)
                    {
                        if (s.Value > 0)
                        {
                            <span class="seg seg-@s.Key.ToLower()" style="width:@(pct(s.Value))%;" title="@s.Key: @s.Value"></span>
                        }
                    }
                </div>
                <div class="db-legend">
                    @foreach (var s in Model.QuarterStatusCounts)
                    {
                        <div class="legend-item">
                            <span class="dot seg-@s.Key.ToLower()"></span>
                            <span class="legend-name">@s.Key</span>
                            <span class="legend-count">@s.Value</span>
                            <span class="legend-pct">@pct(s.Value)%</span>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="db-panel">
            <div class="db-panel-head">
                <h3>Employees by Department</h3>
                <a href="@Url.Action("Index", "EmployeeMaster")" class="db-link">View all</a>
            </div>
            @if (!Model.DepartmentStats.Any())
            {
                <div class="db-empty">No employee data yet.</div>
            }
            else
            {
                foreach (var d in Model.DepartmentStats)
                {
                    <div class="bar-row">
                        <div class="bar-label" title="@d.Label">@d.Label</div>
                        <div class="bar-track"><div class="bar-fill" style="width:@((int)Math.Round(d.Count * 100.0 / maxDept))%;"></div></div>
                        <div class="bar-count">@d.Count</div>
                    </div>
                }
            }
        </div>

        <div class="db-panel">
            <div class="db-panel-head">
                <h3>Recent Quarter Log</h3>
                <a href="@Url.Action("Index", "QuaterLog")" class="db-link">View all</a>
            </div>
            @if (!Model.RecentLogs.Any())
            {
                <div class="db-empty">No quarter log entries yet.</div>
            }
            else
            {
                <div class="db-table-wrap">
                    <table class="db-table">
                        <thead>
                            <tr>
                                <th>Quarter</th>
                                <th>Assigned To</th>
                                <th>Assigned</th>
                                <th>State</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.RecentLogs)
                            {
                                <tr>
                                    <td class="mono">@log.QuaterType/@log.QuaterNo</td>
                                    <td>
                                        @if (log.Employee != null)
                                        {
                                            <div class="t-main">@log.Employee.EmployeeName</div>
                                            <div class="t-sub">@log.Employee.EmployeeNo</div>
                                        }
                                        else
                                        { <span>-</span>}
                                    </td>
                                    <td>@log.AssignedDate.ToString("dd-MMM-yyyy")</td>
                                    <td>
                                        @if (log.RetainedDate.HasValue)
                                        {
                                            <span class="pill pill-amber">Retained</span>
                                        }
                                        else
                                        {
                                            <span class="pill pill-blue">Assigned</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>

    <div class="db-col">

        <div class="db-panel">
            <div class="db-panel-head"><h3>Quick Actions</h3></div>
            <div class="qa-list">
                <a href="@Url.Action("Create", "EmployeeMaster")" class="qa-item">
                    <span class="qa-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg></span>
                    <span class="qa-text">Add Employee</span>
                    <span class="qa-arrow">&rsaquo;</span>
                </a>
                <a href="@Url.Action("ImportExcel", "EmployeeMaster")" class="qa-item">
                    <span class="qa-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg></span>
                    <span class="qa-text">Import from Excel</span>
                    <span class="qa-arrow">&rsaquo;</span>
                </a>
                <a href="@Url.Action("Create", "Quater")" class="qa-item">
                    <span class="qa-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg></span>
                    <span class="qa-text">Add Quarter</span>
                    <span class="qa-arrow">&rsaquo;</span>
                </a>
                <a href="@Url.Action("Create", "QuaterLog")" class="qa-item">
                    <span class="qa-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg></span>
                    <span class="qa-text">Add Quarter Log</span>
                    <span class="qa-arrow">&rsaquo;</span>
                </a>
            </div>
        </div>

        <div class="db-panel">
            <div class="db-panel-head">
                <h3>Retiring Soon</h3>
                <span class="db-note">next 180 days</span>
            </div>
            @if (!Model.RetiringSoon.Any())
            {
                <div class="db-empty">No upcoming retirements.</div>
            }
            else
            {
                foreach (var r in Model.RetiringSoon)
                {
                    <div class="ret-item">
                        <div class="ret-avatar">@r.Name.Substring(0, 1)</div>
                        <div class="ret-info">
                            <div class="t-main">@r.Name</div>
                            <div class="t-sub">@r.EmployeeNo &middot; @r.Department</div>
                        </div>
                        <div class="ret-date">@r.RetirementDate.ToString("dd MMM yyyy")</div>
                    </div>
                }
            }
        </div>

    </div>
</div>

@section Styles {
    <style>
        :root {
            --db-ink: #0f172a;
            --db-text: #1e293b;
            --db-muted: #64748b;
            --db-faint: #94a3b8;
            --db-line: #e8ecf2;
            --db-surface: #ffffff;
            --db-soft: #f8fafc;
            --db-radius: 12px;
            --db-shadow: 0 1px 2px rgba(15,23,42,.04), 0 4px 16px rgba(15,23,42,.05);
        }

        .db-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 24px;
            gap: 12px;
            flex-wrap: wrap;
        }

            .db-head h2 {
                font-size: 22px;
                color: var(--db-ink);
                margin-bottom: 4px;
            }

            .db-head p {
                color: var(--db-muted);
                font-size: 14px;
            }

        .db-date {
            font-size: 13px;
            color: var(--db-muted);
            background: var(--db-surface);
            border: 1px solid var(--db-line);
            padding: 8px 14px;
            border-radius: 8px;
        }

        /* KPI cards */
        .db-kpis {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 18px;
            margin-bottom: 22px;
        }

        .db-kpi {
            display: flex;
            align-items: center;
            gap: 16px;
            background: var(--db-surface);
            border: 1px solid var(--db-line);
            border-radius: var(--db-radius);
            padding: 20px;
            box-shadow: var(--db-shadow);
        }

        .db-kpi-icon {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .c-blue {
            background: #e0ecff;
            color: #1d4ed8;
        }

        .c-slate {
            background: #e8ecf4;
            color: #334155;
        }

        .c-green {
            background: #dcfce7;
            color: #15803d;
        }

        .c-amber {
            background: #fef3c7;
            color: #b45309;
        }

        .db-kpi-label {
            font-size: 12.5px;
            color: var(--db-muted);
            font-weight: 600;
            margin-bottom: 2px;
        }

        .db-kpi-value {
            font-size: 28px;
            font-weight: 700;
            color: var(--db-ink);
            line-height: 1.15;
        }

        .db-kpi-sub {
            font-size: 12px;
            color: var(--db-faint);
            margin-top: 2px;
        }

        /* Grid */
        .db-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 22px;
            align-items: start;
        }

        .db-col {
            display: flex;
            flex-direction: column;
            gap: 22px;
            min-width: 0;
        }

        .db-panel {
            background: var(--db-surface);
            border: 1px solid var(--db-line);
            border-radius: var(--db-radius);
            padding: 22px;
            box-shadow: var(--db-shadow);
        }

        .db-panel-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
        }

            .db-panel-head h3 {
                font-size: 15px;
                color: var(--db-ink);
            }

        .db-link {
            font-size: 12.5px;
            font-weight: 600;
            color: #1d4ed8;
            text-decoration: none;
        }

            .db-link:hover {
                text-decoration: underline;
            }

        .db-note {
            font-size: 12px;
            color: var(--db-faint);
        }

        .db-empty {
            color: var(--db-faint);
            font-size: 13.5px;
            padding: 14px 0;
        }

        /* Quarter status bar */
        .db-statusbar {
            display: flex;
            height: 12px;
            border-radius: 20px;
            overflow: hidden;
            background: #eef1f6;
            margin-bottom: 18px;
        }

        .seg {
            display: block;
            height: 100%;
        }

        .seg-active {
            background: #22c55e;
        }

        .seg-retained {
            background: #f59e0b;
        }

        .seg-occupied {
            background: #3b82f6;
        }

        .seg-vacant {
            background: #cbd5e1;
        }

        .db-legend {
            display: grid;
            grid-template-columns: repeat(2,1fr);
            gap: 10px 24px;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
        }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .legend-name {
            color: var(--db-text);
            flex: 1;
        }

        .legend-count {
            font-weight: 700;
            color: var(--db-ink);
        }

        .legend-pct {
            color: var(--db-faint);
            width: 42px;
            text-align: right;
            font-size: 12px;
        }

        /* Department bars */
        .bar-row {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
        }

            .bar-row:last-child {
                margin-bottom: 0;
            }

        .bar-label {
            width: 150px;
            font-size: 13px;
            color: var(--db-text);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .bar-track {
            flex: 1;
            height: 8px;
            background: #eef1f6;
            border-radius: 20px;
            overflow: hidden;
        }

        .bar-fill {
            height: 100%;
            background: linear-gradient(90deg,#1e293b,#475569);
            border-radius: 20px;
        }

        .bar-count {
            width: 34px;
            text-align: right;
            font-size: 13px;
            font-weight: 700;
            color: var(--db-ink);
        }

        /* Table */
        .db-table-wrap {
            overflow-x: auto;
            margin: 0 -6px;
        }

        .db-table {
            width: 100%;
            border-collapse: collapse;
        }

            .db-table th {
                text-align: left;
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: .5px;
                color: var(--db-muted);
                font-weight: 700;
                padding: 10px 6px;
                border-bottom: 1px solid var(--db-line);
            }

            .db-table td {
                padding: 12px 6px;
                border-bottom: 1px solid #f1f4f8;
                font-size: 13.5px;
                color: var(--db-text);
                vertical-align: middle;
            }

            .db-table tbody tr:last-child td {
                border-bottom: none;
            }

        .mono {
            font-family: 'IBM Plex Mono', Consolas, monospace;
            font-size: 13px;
            color: #475569;
        }

        .t-main {
            color: var(--db-ink);
            font-weight: 600;
            font-size: 13.5px;
        }

        .t-sub {
            color: var(--db-faint);
            font-size: 11.5px;
            margin-top: 1px;
        }

        .pill {
            display: inline-block;
            padding: 3px 11px;
            border-radius: 20px;
            font-size: 11.5px;
            font-weight: 700;
        }

        .pill-blue {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .pill-amber {
            background: #fef3c7;
            color: #b45309;
        }

        /* Quick actions */
        .qa-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .qa-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 12px;
            border: 1px solid var(--db-line);
            border-radius: 10px;
            text-decoration: none;
            color: var(--db-text);
            transition: background .15s, border-color .15s;
        }

            .qa-item:hover {
                background: var(--db-soft);
                border-color: #cbd5e1;
            }

        .qa-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: #f1f5f9;
            color: var(--db-ink);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .qa-text {
            flex: 1;
            font-size: 13.5px;
            font-weight: 600;
        }

        .qa-arrow {
            color: var(--db-faint);
            font-size: 20px;
            line-height: 1;
        }

        /* Retiring soon */
        .ret-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 0;
            border-bottom: 1px solid #f1f4f8;
        }

            .ret-item:last-child {
                border-bottom: none;
                padding-bottom: 0;
            }

        .ret-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: var(--db-ink);
            color: #fff;
            font-weight: 700;
            font-size: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .ret-info {
            flex: 1;
            min-width: 0;
        }

            .ret-info .t-main, .ret-info .t-sub {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

        .ret-date {
            font-size: 12px;
            font-weight: 600;
            color: #b45309;
            background: #fef3c7;
            padding: 4px 10px;
            border-radius: 20px;
            white-space: nowrap;
        }

        @@media (max-width: 1100px) {
            .db-kpis {
                grid-template-columns: repeat(2,1fr);
            }

            .db-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 600px) {
            .db-kpis {
                grid-template-columns: 1fr;
            }

            .db-legend {
                grid-template-columns: 1fr;
            }

            .bar-label {
                width: 100px;
            }
        }
    </style>
}